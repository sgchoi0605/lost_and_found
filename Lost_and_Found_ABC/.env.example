# Express 서버가 요청을 받을 주소와 포트입니다. 필요하면 .env로 복사해 변경합니다.
HOST=127.0.0.1
PORT=3000
# SQLite 파일 위치입니다. 상대 경로는 프로젝트 루트 기준이며 실제 DB는 Git에 올리지 않습니다.
DATABASE_PATH=database/lostfound.db
# HTTPS 배포 시 NODE_ENV=production으로 Secure 쿠키를 활성화하세요.
# NODE_ENV=production
# 역방향 프록시 배포 시 사용자가 접속하는 정확한 origin을 지정하세요.
# APP_ORIGIN=https://lostfound.example.com
